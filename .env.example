# Copiar a .env y reemplazar con valores reales (nunca commitear .env).
# Longitud mínima recomendada para secretos JWT: 16 caracteres.

# --- App ---
NODE_ENV=development
PORT=3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=nest-api-template
DB_TIMEZONE=-03:00
# true = TypeORM crea/altera tablas al arrancar (solo desarrollo; nunca en producción).
DB_SYNCHRONIZE=false

# --- JWT ---
# Opcional: secreto para validar tokens emitidos por la API AUTH externa (puede ser corto; lo define el proveedor).
JWT_SECRET=
# Obligatorios: tokens emitidos por esta API (mín. 16 caracteres en validación de arranque).
ACCESS_TOKEN_SECRET=change-me-min-16-chars-xx
ACCESS_TOKEN_REFRESH_SECRET=change-me-min-16-chars-xx
ACCESS_TOKEN_EXPIRES_IN=1d
ACCESS_TOKEN_REFRESH_EXPIRES_IN=30d

# --- Integración AUTH API externa (opcional) ---
AUTH_API_URL=https://auth.pushsoftware.com.ar/

# --- Cloudflare R2 (opcional) ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_DEVELOPMENT_URL=
R2_PRODUCTION_URL=

# --- SMTP (opcional) ---
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="API Template <noreply@example.com>"
APP_BASE_URL=http://localhost:3000

# URL pública de esta API (para webhooks de Mercado Pago). En local usá ngrok o similar.
PUBLIC_API_BASE_URL=http://localhost:3000

# Landing Next (back_urls del checkout MP)
LANDING_BASE_URL=http://localhost:3001

# Mercado Pago — checkout de suscripción (access token de la cuenta)
MERCADOPAGO_ACCESS_TOKEN=

# Si no hay token MP, con true se activa el plan al llamar POST /suscripcion/checkout (solo desarrollo)
ALLOW_SUBSCRIPTION_MOCK_CHECKOUT=false

# --- Firebase (opcional) ---
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
